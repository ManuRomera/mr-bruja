<section class="br-end {{#if end.dead}}dead{{else}}legacy{{/if}}">
  <img class="br-end-art" src="{{end.art}}" alt="">
  <div class="br-end-body">
    {{#if end.dead}}
      <h2><i class="fa-solid fa-moon" aria-hidden="true"></i> {{localize "BR.End.DeathTitle"}}</h2>
      <p class="br-lede">{{localize "BR.End.DeathText" name=end.brujaNombre}}</p>
    {{else}}
      <h2><i class="fa-solid fa-crown" aria-hidden="true"></i> {{localize "BR.End.LegacyTitle"}}</h2>
      {{#if end.chosen}}<div class="br-chosen"><span class="br-heir-portrait"><img src="{{end.chosen.portrait}}" alt=""><img class="br-seal" src="systems/mr-bruja/assets/art/extras/sello-cera.webp" alt=""></span><p class="br-lede">{{localize "BR.End.LegacyText" name=end.brujaNombre heir=end.chosen.nombre}}</p></div>{{/if}}
      <p class="br-hint">{{localize "BR.End.NoDice"}}</p>
    {{/if}}

    {{#if end.fin}}
      {{#if end.texto}}<blockquote class="br-final-text">{{end.texto}}</blockquote>{{/if}}
      <button type="button" class="br-primary" data-action="grimoire"><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize "BR.End.SeeGrimoire"}}</button>
    {{else}}
      <label><span>{{#if end.dead}}{{localize "BR.End.LastWords"}}{{else}}{{localize "BR.End.Epilogue"}}{{/if}}</span>
        <textarea name="final" rows="5" maxlength="1500" placeholder="{{localize 'BR.End.Placeholder'}}"></textarea>
      </label>
      <div class="br-row-end">
        {{#if end.canReveal}}<button type="button" data-action="revealAll"><i class="fa-solid fa-eye" aria-hidden="true"></i> {{localize "BR.End.Reveal"}}</button>{{/if}}
        {{#if end.canClose}}<button type="button" class="br-primary" data-action="end"><i class="fa-solid fa-book-skull" aria-hidden="true"></i> {{localize "BR.End.Close"}}</button>{{/if}}
      </div>
    {{/if}}
  </div>
</section>
