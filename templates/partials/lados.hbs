{{#if right}}
{{!-- Derecha: posibles herederas y recetas, como las hojas del libro --}}
<section class="br-page br-heirs-sheet">
  <h2 class="br-sheet-title">{{localize "BR.Side.Heirs"}}</h2>
  <ul class="br-heir-list">
    {{#each side.herederas}}
    <li class="{{#if elegida}}chosen{{/if}}">
      <span class="br-heir-portrait"><img src="{{portrait}}" alt=""><img class="br-seal" src="systems/mr-bruja/assets/art/extras/sello-cera.webp" alt=""></span>
      <span class="br-heir-text"><strong>{{nombre}}</strong>{{#if nota}}<small>{{nota}}</small>{{/if}}</span>
    </li>
    {{/each}}
    {{#each side.emptySlots}}<li class="empty"><span class="br-heir-portrait"></span><span class="br-heir-text"><small>{{localize "BR.Side.EmptyHeir"}}</small></span></li>{{/each}}
  </ul>
</section>

<section class="br-page br-recipes-sheet">
  <h2 class="br-sheet-title">{{localize "BR.Side.Recipes"}}</h2>
  <ul class="br-recipe-list">
    {{#each side.recipes}}
    <li class="{{#if enabled}}can{{/if}} {{#if on}}on{{/if}}">
      <span class="br-cost" aria-label="{{cost}} PD">{{cost}}</span>
      <span class="br-recipe-text"><strong><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{label}}</strong><small>{{hint}}</small></span>
      {{#if input}}
      <span class="br-recipe-form">
        <input type="text" name="herederaNombre" placeholder="{{localize 'BR.Recipe.HeirName'}}" aria-label="{{localize 'BR.Recipe.HeirName'}}" {{#unless enabled}}disabled{{/unless}}>
        <input type="text" name="herederaNota" placeholder="{{localize 'BR.Recipe.HeirNote'}}" aria-label="{{localize 'BR.Recipe.HeirNote'}}" {{#unless enabled}}disabled{{/unless}}>
      </span>
      {{/if}}
      {{#if select}}
      <span class="br-recipe-form"><select name="herederaElegida" aria-label="{{localize 'BR.Recipe.elegir'}}" {{#unless enabled}}disabled{{/unless}}>{{#each @root.side.herederas}}<option value="{{id}}">{{nombre}}</option>{{/each}}</select></span>
      {{/if}}
      <button type="button" data-action="{{action}}" {{#unless enabled}}disabled{{/unless}}>{{#if on}}{{localize "BR.Recipe.Undo"}}{{else}}{{localize "BR.Recipe.Use"}}{{/if}}</button>
    </li>
    {{/each}}
  </ul>
</section>
{{else}}
{{!-- Izquierda: la hoja de Bruja --}}
<aside class="br-left" aria-label="{{localize 'BR.Side.Witch'}}">
  <section class="br-page br-witch-sheet">
    <h2 class="br-sheet-title br-sheet-bruja">{{localize "BR.Side.Witch"}}</h2>
    <div class="br-witch-head">
      <img class="br-witch-portrait" src="{{bruja.portrait}}" alt="">
      <div>
        <p class="br-field-label">{{localize "BR.Prep.Name"}}</p>
        <p class="br-field-value">{{bruja.nombre}}</p>
        {{#if bruja.apodo}}<p class="br-nick">«{{bruja.apodo}}»</p>{{/if}}
      </div>
    </div>
    <p class="br-field-label">{{localize "BR.Prep.Trait"}}</p>
    <p class="br-field-value br-trait">{{bruja.rasgo}}</p>

    <p class="br-field-label br-bag-label">{{localize "BR.Side.Bag"}}</p>
    <ul class="br-bag">
      {{#each bruja.bolsa}}
      <li><img class="br-bag-sprite" src="{{sprite}}" alt=""><span><small>{{label}}</small><strong>{{nombre}}</strong>{{#if detalle}}<em>{{detalle}}</em>{{/if}}</span></li>
      {{/each}}
    </ul>
    <img class="br-vignette" src="systems/mr-bruja/assets/art/objects/rana.webp" alt="">
  </section>
</aside>
{{/if}}
