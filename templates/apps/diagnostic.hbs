<div class="br-diagnostic">
  <p class="br-status {{#if ok}}ok{{else}}bad{{/if}}"><i class="fa-solid {{#if ok}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}" aria-hidden="true"></i>{{#if ok}}{{localize "BR.Diagnostic.AllGood"}}{{else}}{{localize "BR.Diagnostic.Problems"}}{{/if}}</p>
  {{#if errors.length}}<ul class="br-diag-list">{{#each errors}}<li><strong>{{phase}}</strong> {{message}}</li>{{/each}}</ul>{{/if}}
  {{#if missing.length}}<ul class="br-diag-list">{{#each missing}}<li><strong>{{localize "BR.Diagnostic.Missing"}}</strong> {{this}}</li>{{/each}}</ul>{{/if}}
  <textarea readonly aria-label="{{localize 'BR.Diagnostic.Title'}}">{{json}}</textarea>
  <footer class="br-row-end">
    <button type="button" data-action="refresh"><i class="fa-solid fa-rotate" aria-hidden="true"></i>{{localize "BR.Diagnostic.Refresh"}}</button>
    <button type="button" class="br-primary" data-action="copy"><i class="fa-regular fa-copy" aria-hidden="true"></i>{{localize "BR.Diagnostic.Copy"}}</button>
  </footer>
</div>
