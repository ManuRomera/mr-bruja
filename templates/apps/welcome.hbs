<div class="br-welcome">
  <img class="br-welcome-art" src="{{cover}}" alt="">
  <p><strong>{{localize "BR.Welcome.Ready"}}</strong> {{localize "BR.Welcome.Body"}}</p>
  <div class="br-welcome-grid">
    <button type="button" class="br-primary" data-action="go" data-app="choza"><i class="fa-solid fa-hat-wizard" aria-hidden="true"></i>{{localize "BR.Welcome.Table"}}</button>
    <button type="button" data-action="go" data-app="safety"><i class="fa-solid fa-shield-heart" aria-hidden="true"></i>{{localize "BR.Welcome.Safety"}}</button>
    <button type="button" data-action="go" data-app="access"><i class="fa-solid fa-universal-access" aria-hidden="true"></i>{{localize "BR.Access.Title"}}</button>
  </div>
  <button type="button" class="br-link" data-action="hide">{{localize "BR.Welcome.Hide"}}</button>
</div>
